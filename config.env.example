# ====================================================================
# Data Quality Documenter - Portable Windows Edition
# Example Configuration Environment File (.env format)
# ====================================================================
# You can import this file via: Settings > Import Configuration (.env)
# Do NOT place secrets, passwords, or credentials in client configuration.

# Application Information
APP_NAME="Data Quality Documenter"

# Branding and Colors
BRANDING_LOGO_PATH="./assets/logo.png"
BRANDING_FAVICON_PATH="./assets/logo.png"
BRANDING_PRIMARY_COLOR="#1F4E79"
BRANDING_SECONDARY_COLOR="#4472C4"
BRANDING_ACCENT_COLOR="#00A6A6"
BRANDING_BACKGROUND_COLOR="#F5F7FA"
BRANDING_TEXT_COLOR="#1F2937"
BRANDING_FONT_FAMILY="Segoe UI, Arial, sans-serif"
BRANDING_FOOTER_TEXT="Data Quality Documenter - Internal Enterprise Edition"
BRANDING_SHOW_LOGO=true
BRANDING_SHOW_PAGE_NUMBERS=true

# PDF Settings
PDF_PAPER_SIZE="A4"
PDF_ORIENTATION="portrait"
PDF_INCLUDE_TOC=true
PDF_INCLUDE_METADATA=true
PDF_INCLUDE_REVISION_HISTORY=true
PDF_INCLUDE_APPROVALS=true

# Required Fields (comma separated)
REQUIRED_FIELDS="rule_name,rule_description,validation_type,data_source,sql_query,expected_result"

# Optional Fields (comma separated)
OPTIONAL_FIELDS="business_domain,owner,priority,execution_frequency,actual_result,remediation,reviewer,threshold,severity"

# Feature Toggles (true/false)
FEATURE_TEMPLATES=true
FEATURE_PDF_IMPORT=true
FEATURE_SQL_EDITOR=true
FEATURE_FILESYSTEM_SEARCH=true
FEATURE_EXCEL_IMPORT_EXPORT=true
FEATURE_DBT_IMPORT=true
FEATURE_VERSIONING=true
FEATURE_APPROVALS=true
FEATURE_AUDIT_TRAIL=true
FEATURE_ISSUE_TRACKING=true
FEATURE_QUALITY_SCORECARDS=true

# Operational Limits
LIMIT_MAX_PDF_SIZE_MB=50
LIMIT_MAX_FILE_SIZE_MB=25
LIMIT_MAX_SEARCH_RESULTS=100
